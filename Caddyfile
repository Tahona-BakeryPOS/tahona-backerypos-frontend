# Caddy: automatic HTTPS (Let's Encrypt), static PWA and a proxy of /api to the API.
# DOMAIN, ACME_EMAIL and API_UPSTREAM come from the .env (deploy/docker-compose.yml).
# API_UPSTREAM is the API's public URL, e.g. https://api.yourbakery.co. Since the browser only talks to DOMAIN,
# the calls to /api/v1 are same-origin and need no CORS.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# API (the backend is deployed on its own).
	handle /api/* {
		reverse_proxy {$API_UPSTREAM} {
			header_up Host {upstream_hostport}
		}
	}

	# Frontend health check for external monitoring.
	handle /health {
		respond "OK" 200
	}

	# PWA: the index and the service-worker files are never cached, so a new version reaches the registers.
	handle {
		root * /srv
		@nocache path / /index.html /ngsw.json /ngsw-worker.js /safety-worker.js /manifest.webmanifest
		header @nocache Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
