# Copia como .env.staging o .env.production en el VPS (nunca en el repo) con permisos 600.

# staging o production (nombre del proyecto de Compose y de los volúmenes)
ENVIRONMENT=staging
# Versión de la imagen: la pone scripts/deploy.sh (commit de este repo); se puede fijar para volver atrás.
VERSION=

# Dominio público del frontend (DNS tipo A apuntando al VPS) y correo para Let's Encrypt
DOMAIN=
ACME_EMAIL=

# URL pública del API (la del repo del backend, su API_DOMAIN), p. ej. https://api.tupanaderia.co
API_UPSTREAM=
